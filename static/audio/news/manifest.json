    "news:bn:export-news-16-14": {
      "key": "news:bn:export-news-16-14",
      "item_id": "export-news-16-14",
      "lang": "bn",
      "category": "press",
      "file": "static/audio/news/bn/export-news-16-14.mp3",
      "text": "সিটি ব্যাংক তাদের অনুমোদিত মূলধন বাড়িয়ে ৩,০০০ কোটি টাকায় উন্নীত করার পরিকল্পনা করেছে। ভবিষ্যৎ ব্যবসার সম্প্রসারণ, আন্তর্জাতিক বাণিজ্য অর্থায়ন এবং ঝুঁকি মোকাবিলায় মূলধন ভিত্তি শক্তিশালী করাই এর মূল লক্ষ্য।",
      "text_sha256": "f517812bd90d0f94864762c7106cc2a6cacb01939feead69f4421d62b81dac75",
      "approved_exact_text": true,
      "key_name_used": "secondary",
      "voice_id": "5WbDBNLwAg4h26Km0GgQ",
      "audio_sha256": "b9ff484111389226f99b2316f0d7a10a1452cd7e88523cac34c352a85417afb8",
      "reviewed": true
    },

    "news:bn:export-news-2-11": {
      "key": "news:bn:export-news-2-11",
      "item_id": "export-news-2-11",
      "lang": "bn",
      "category": "press",
      "file": "static/audio/news/bn/export-news-2-11.mp3",
      "text": "ব্র্যাক ব্যাংক ও সিটি ব্যাংক যৌথভাবে বাংলাদেশে স্মার্ট লকার সেবা ‘ডিজিবক্স’ চালু করেছে। এর মাধ্যমে গ্রাহকরা সপ্তাহের ৭ দিন ২৪ ঘণ্টাই স্বয়ংক্রিয় প্রযুক্তির মাধ্যমে নিরাপদে পার্সেল ও প্রয়োজনীয় সামগ্রী গ্রহণ বা জমা দিতে পারবেন।",
      "text_sha256": "783ea94bca74ed3db519be0a3de5387de8d6736a49aab5eac7eb3c43e30cad0a",
      "approved_exact_text": true,
      "key_name_used": "secondary",

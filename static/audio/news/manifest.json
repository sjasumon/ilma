      "lang": "bn",
      "category": "press",
      "file": "static/audio/news/bn/export-news-13-11.mp3",
      "text": "২০২৬ সালের জানুয়ারি থেকে জুন সময়ে ব্র্যাক ব্যাংকের নিট মুনাফা ৫৭ শতাংশ বৃদ্ধি পেয়েছে। আমানত বৃদ্ধি, এসএমই ঋণ এবং পরিচালন ব্যয় দক্ষতার কারণে ব্যাংকের সামগ্রিক আয় উল্লেখযোগ্যভাবে বেড়েছে।",
      "text_sha256": "1b5eeb1ecd5289b701d3a08e7a2a4f7544de176aa2deb0b2cf5d47e2a61f5787",
      "approved_exact_text": true,
      "key_name_used": "secondary",
      "voice_id": "5WbDBNLwAg4h26Km0GgQ",
      "audio_sha256": "3c9db5148a645c400594ffaf51561717548c99d3745ff6ac8d08bcf60dca58e1",
      "reviewed": true
    },

      "audio_sha256": "69bfd9aacc390a32cd99c2948ecd23ccbdef9266aae75610f50b8ca338c74987",
      "reviewed": true
    },
    "news:bn:export-news-12-11": {
      "key": "news:bn:export-news-12-11",
      "item_id": "export-news-12-11",
      "lang": "bn",
      "category": "press",
      "file": "static/audio/news/bn/export-news-12-11.mp3",
      "text": "ব্র্যাক ব্যাংক পরিবেশবান্ধব প্রকল্প ও টেকসই শিল্প উদ্যোগে অর্থায়নের জন্য দেশের প্রথম ১,০০০ কোটি টাকার গ্রিন বন্ড ছাড়ার উদ্যোগ নিয়েছে। এটি পরিবেশবান্ধব বিনিয়োগ ও সবুজ অর্থায়নে একটি নতুন মাইলফলক।",
      "text_sha256": "7dbac850f1ca2c5930f4e25a12bcbd340125d0edaffd2ec62f500e1a1bb24f51",
      "approved_exact_text": true,
      "key_name_used": "secondary",

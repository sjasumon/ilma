# Use your existing MySQL database URL in production.
DATABASE_URL=
APP_HOST=0.0.0.0
APP_PORT=8001
MUSE_VOICE_API_KEY=
MUSE_VOICE_API_URL=https://api.meta.ai/v1/asr/transcribe
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0
META_MODEL_API_KEY=
MUSE_SPARK_API_URL=https://api.meta.ai/v1/chat/completions
MUSE_SPARK_MODEL=muse-spark-1.3
VOICE_SILENCE_MS=1500
FFMPEG_BINARY=ffmpeg
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
SPEECH_TIMEOUT_SECONDS=25
VOICE_LOG_SALT=

# MySQL connection: enter password directly, no URL encoding needed.
DB_HOST='127.0.0.1'
DB_PORT='3306'
DB_NAME=''
DB_USERNAME=''
DB_PASSWORD=''

# Private CSV input directory for the service converter; never commit raw exports.
EXPORT_DIR=

# Development diagnostics ONLY. Leave disabled in production.
ILMA_ENV=production
VOICE_DIAGNOSTICS_ENABLED=false
# Serve /voice-test only during a physical-device acceptance window.
VOICE_TEST_PAGE_ENABLED=false

# Provider budgets are per process: use one worker until a shared ingress limiter exists.
CORS_ORIGINS=https://app.sumon.me,http://localhost:8001,http://127.0.0.1:8001
API_CLIENT_PER_MINUTE=12
API_GLOBAL_PER_MINUTE=60
API_GLOBAL_PER_DAY=1000
API_CLIENT_CONCURRENCY=2
API_GLOBAL_CONCURRENCY=4
API_UPLOAD_TIMEOUT_SECONDS=20

# Independent claim-check call; empty uses the configured Spark model.
MUSE_CHECK_MODEL=

[Unit]
Description=ILMA local database/API readiness probe
OnFailure=ilma-ops-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/shared/all_projects/ilma
Environment=PYTHONPATH=/home/ubuntu/shared/all_projects/ilma/api
Environment=DB_NAME=ilma
ExecStart=/home/ubuntu/venv/bin/python -m ilma_api.monitor
NoNewPrivileges=true
PrivateTmp=true

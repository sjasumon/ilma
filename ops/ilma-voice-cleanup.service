[Unit]
Description=ILMA voice data retention cleanup
OnFailure=ilma-ops-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/shared/all_projects/ilma
Environment=PYTHONPATH=/home/ubuntu/shared/all_projects/ilma/api
Environment=DB_NAME=ilma
ExecStart=/home/ubuntu/venv/bin/python -m ilma_api.voice_maintenance
User=ubuntu
Group=ubuntu
NoNewPrivileges=true
PrivateTmp=true

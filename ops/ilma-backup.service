[Unit]
Description=Private ILMA MySQL backup
After=mysql.service
OnFailure=ilma-ops-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/shared/all_projects/ilma
Environment=PYTHONPATH=/home/ubuntu/shared/all_projects/ilma/api
Environment=DB_NAME=ilma
ExecStart=/home/ubuntu/venv/bin/python -m ilma_api.recovery backup
StateDirectory=ilma-backups
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ilma-backups
